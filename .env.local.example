# Copy this file to .env.local and fill in your real Supabase project values.
# Get these from your Supabase project: Project Settings -> API.
#
# NEXT_PUBLIC_ variables are exposed to the browser — that's expected and
# safe for these two values (the anon key is meant to be public; Row Level
# Security policies in supabase/schema.sql are what actually protect data).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
